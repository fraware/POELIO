{
  "name": "poelio-experience",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run verify:fixture && npm run typecheck && vite build && node scripts/create_offline_shell.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "verify:fixture": "node scripts/verify_approved_demo.mjs",
    "test:offline": "node --test scripts/offline_shell.test.mjs",
    "build:subpath": "npm run verify:fixture && npm run typecheck && vite build --base /POELIO/ && node scripts/create_offline_shell.mjs",
    "test:subpath": "playwright test -c playwright.subpath.config.ts"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3",
    "vite": "7.0.0",
    "vitest": "3.2.0",
    "@playwright/test": "1.54.2",
    "@axe-core/playwright": "4.13.0"
  }
}
