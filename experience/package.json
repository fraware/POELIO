{
  "name": "poelio-experience",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run verify:fixture && npm run typecheck && vite build && node scripts/create_offline_shell.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "verify:fixture": "node scripts/verify_approved_demo.mjs",
    "test:offline": "node --test scripts/offline_shell.test.mjs",
    "build:subpath": "npm run verify:fixture && npm run typecheck && vite build --base /POELIO/ && node scripts/create_offline_shell.mjs",
    "test:subpath": "playwright test -c playwright.subpath.config.ts",
    "audit:root": "node scripts/audit_release.mjs root",
    "audit:subpath": "node scripts/audit_release.mjs subpath",
    "test:release": "node --test scripts/audit_release.test.mjs",
    "test:host-headers": "node --test scripts/audit_host_headers.test.mjs",
    "test:compare": "node --test scripts/compare_release.test.mjs",
    "compare:variants": "node scripts/compare_release.mjs variants release-audit/root.json release-audit/subpath.json"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  },
  "license": "MIT",
  "author": "Mateo Petel and POELIO contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraware/POELIO.git"
  },
  "homepage": "https://github.com/fraware/POELIO#readme",
  "bugs": {
    "url": "https://github.com/fraware/POELIO/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "digital-humanities",
    "electronic-literature",
    "interactive-literature",
    "constrained-writing",
    "creative-writing",
    "literary-interpretation",
    "oulipo",
    "formal-methods",
    "education",
    "privacy-first",
    "typescript"
  ],
  "description": "POELIO six-stage literary-reading and writing experience with public-only authored works"
}
