{
  "name": "poelio",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Public, publication-safe foundation for explorable literature",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run compile && node --test tests/*.test.mjs",
    "build:public": "python3 scripts/build_public.py",
    "check:public": "python3 scripts/check_public.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "author": "Mateo Petel and POELIO contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraware/POELIO.git"
  },
  "homepage": "https://github.com/fraware/POELIO#readme",
  "bugs": {
    "url": "https://github.com/fraware/POELIO/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "digital-humanities",
    "electronic-literature",
    "interactive-literature",
    "constrained-writing",
    "creative-writing",
    "literary-interpretation",
    "oulipo",
    "formal-methods",
    "education",
    "privacy-first",
    "typescript"
  ]
}
